DATABASE_HOST=localhost
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
FRONTEND_ORIGIN=http://localhost:5173
DEVISE_JWT_SECRET_KEY=change_me_to_a_long_random_value
# Used to build absolute photo/cover-image URLs (the API and frontend are
# on different origins, so relative Active Storage URLs 404 in the
# browser). Set this to the API's real URL in production.
BACKEND_URL=http://localhost:3000
